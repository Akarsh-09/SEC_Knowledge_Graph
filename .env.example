LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
SEC_USER_AGENT=Your Name contact@example.com

# Optional; leave empty for providers that do not support reasoning_effort.
LLM_REASONING_EFFORT=

# Optional same-endpoint model fallbacks on HTTP 429/503, comma-separated.
LLM_FALLBACK_MODELS=
# Minimum seconds between request starts, including retries; 0 disables pacing.
LLM_MIN_INTERVAL_SECONDS=0

# Explicit opt-in only. Live planner/provider failures otherwise propagate.
# Offline cache misses always use deterministic planning.
PLANNER_ALLOW_LIVE_FALLBACK=false
